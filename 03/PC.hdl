/**
 * A 16-bit counter.
 * if      reset(t): out(t+1) = 0
 * else if load(t):  out(t+1) = in(t)
 * else if inc(t):   out(t+1) = out(t) + 1
 * else              out(t+1) = out(t)

 * if inc === 1, output++
 * if in, and load is 1 then just output the input.
 * reset will 
 */
CHIP PC {
    IN in[16], reset, load, inc;
    OUT out[16];
    
    PARTS:
    // Reset has highest priority
    // then load
    // then inc
    // then hold

    // Three mux/selectors to choose from inc, load(input), or reset
    // increment cant just be input, but previous value
    // thus need to plug in output from register back into input
    
    Inc16(in=r1, out=inc1 );
    Mux16(a=in, b=inc1, sel=inc, out=m1 );
    Mux16(a=m1, b=in, sel=load, out=m2);
    Mux16(a=m2, b=false, sel=reset, out=m3 );

    Or(a=inc, b=load , out=o1);
    Or(a=reset, b=o1, out=o2);

    Register(in=m3, load=o2, out=out, out=r1 );

}
