// File name: projects/3/a/RAM64.hdl
/**
 * Memory of sixty four 16-bit registers.
 * If load is asserted, the value of the register selected by
 * address is set to in; Otherwise, the value does not change.
 * The value of the selected register is emitted by out.
 */
CHIP RAM64 {
    IN in[16], load, address[6];
    OUT out[16];

    PARTS:
    RAM8(in=in, load=load1, address=address[0..2], out=r1 );
    RAM8(in=in, load=load2, address=address[0..2], out=r2);
    RAM8(in=in, load=load3, address=address[0..2], out=r3);
    RAM8(in=in, load=load4, address=address[0..2], out=r4);
    RAM8(in=in, load=load5, address=address[0..2], out=r5);
    RAM8(in=in, load=load6, address=address[0..2], out=r6);
    RAM8(in=in, load=load7, address=address[0..2], out=r7);
    RAM8(in=in, load=load8, address=address[0..2], out=r8);

// Handle only the xxx bits of the address to select appropriate RAM
DMux8Way(in=load, sel=address[3..5], a=load1 , b=load2,
 c=load3 , d=load4, e=load5, f=load6, g=load7, h=load8 );


Mux8Way16(a=r1,b=r2, c=r3, d=r4, 
e=r5 , f=r6 , g=r7 , h=r8, sel=address[3..5], out=out );
}

// step 1. use 8 ram8 chips. each ram8 chip takes in the 16 bit input.
// step 2. use a dmux/splitter. input for dmux is the load signal, selection bit is address 3..5 ie the yyy address
// This selects indivudal register on the ram 8 chip.
// step2b. output of splitter is the load signals, each signal goes to the ram8 chip as individual load signals.
// step3 ram8chips output goes to the mux, with the mux seletion address 3..5. 
step 4 output of selector is the answer.
